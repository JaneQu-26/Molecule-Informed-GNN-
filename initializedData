WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
DARK_GRAY = (90, 90, 90)
ELEMENT_COLORS = {"C": (85, 85, 85), "N": (48, 80, 248),
                  "O": (224, 32, 32), "S": (224, 192, 32)}
OTHER_COLOR = (187, 136, 221)

WIDTH, HEIGHT, MARGIN = 1000, 500, 60
NODE_RADIUS = 14

smiles = smiles_list[chem]


def draw_text(surface, text, font, color, center):
    image = font.render(text, True, color)
    surface.blit(image, image.get_rect(center=center))


mol = Chem.MolFromSmiles(smiles)
AllChem.Compute2DCoords(mol)
conf = mol.GetConformer()
n = mol.GetNumAtoms()

get_coord = []
for i in range(n):
    get_coord.append([conf.GetAtomPosition(i).x, -conf.GetAtomPosition(i).y])
coords = np.array(get_coord)
coords -= coords.min(axis=0)
# scale = min((WIDTH - 2 * MARGIN) / coords[:, 0].max(),
#             (HEIGHT - 2 * MARGIN) / coords[:, 1].max())
coords *= 30
coords += [(WIDTH - coords[:, 0].max()) / 2, (HEIGHT - coords[:, 1].max()) / 2]
from collections import defaultdict
nodes = defaultdict(list)
for i, (x, y) in enumerate(coords):
    nodes[i] = (int(x), int(y))

colors = defaultdict(list)
for atom in mol.GetAtoms():
    colors[atom.GetIdx()] = ELEMENT_COLORS.get(atom.GetSymbol(), OTHER_COLOR)

bonds = []
for b in mol.GetBonds():
    bonds.append((b.GetBeginAtomIdx(), b.GetEndAtomIdx(),
          max(1, int(b.GetBondTypeAsDouble()))))



def draw_bond(surface, start, end, order):
    p, q = pygame.Vector2(start), pygame.Vector2(end)
    direction = (q - p).normalize()
    normal = pygame.Vector2(-direction.y, direction.x)
    offsets = {1: [0], 2: [-4, 4], 3: [-7, 0, 7]}[order]
    for o in offsets:
        pygame.draw.line(surface, DARK_GRAY, p + normal * o, q + normal * o, 2)


def draw_molecule(surface, font):
    for start, end, order in bonds:
        draw_bond(surface, nodes[start], nodes[end], order)
    for name, position in nodes.items():
        pygame.draw.circle(surface, colors[name], position, NODE_RADIUS)
        pygame.draw.circle(surface, BLACK, position, NODE_RADIUS, 2)
        draw_text(surface, str(name), font, WHITE, position)


pygame.init()
